PORT=8080
GROQ_API_KEY=ganti_dengan_api_key_groq_kamu
GROQ_MODEL=llama-3.1-8b-instant
NODE_ENV=development

# Web Push (notifikasi jadwal konseling ke siswa)
# Generate sekali dengan: node scripts/generate-vapid-keys.js
# Lalu isi VITE_VAPID_PUBLIC_KEY di frontend/.env dengan nilai VAPID_PUBLIC_KEY yang sama.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@stopbullying.example

# JWT auth (ganti di production)
JWT_SECRET=bk-system-dev-secret-ganti-di-production
JWT_EXPIRES_IN=12h

# WAJIB diisi kalau frontend & backend beda subdomain di VPS
# (mis. frontend di smandarussholahkonseling.my.id, backend di
# api.smandarussholahkonseling.my.id). Harus diawali titik agar
# cookie (termasuk csrf_token) bisa dibaca lintas subdomain.
# Kosongkan kalau frontend & backend satu host yang sama persis.
COOKIE_DOMAIN=.smandarussholahkonseling.my.id
